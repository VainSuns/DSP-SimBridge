static int @NAME@_transfer_until(@TYPED@PcSocket *socket, uint8_t *data,
    uint32_t length, const @TYPED@PcDeadline *deadline,
    @TYPED@PcError *error, int sending)
{
    uint32_t done = 0u;
    @NAME@_native_socket native;
    if (socket == NULL || !socket->valid ||
            (length != 0u && (data == NULL || deadline == NULL))) {
        if (error != NULL) error->kind = @MACRO@_PC_ERROR_ARGUMENT;
        return -1;
    }
    socket->last_transfer_count = 0u;
    if (length == 0u) return 0;
    native = @NAME@_native(socket);
    while (done < length) {
        uint32_t remaining = length - done;
        int chunk = remaining > 65536u ? 65536 : (int)remaining;
        int os_error = 0;
        int ready = @NAME@_wait(socket, sending, deadline, error, &os_error);
        int count;
        if (ready == 0) {
            socket->last_transfer_count = done;
            return @NAME@_fail(socket, error, @MACRO@_PC_ERROR_TIMEOUT, 0);
        }
        if (ready < 0) {
            socket->last_transfer_count = done;
            if (error != NULL && error->kind == @MACRO@_PC_ERROR_INTERNAL) {
                return -1;
            }
            return @NAME@_fail(socket, error, @MACRO@_PC_ERROR_SOCKET, os_error);
        }
        if (sending) {
#ifdef MSG_NOSIGNAL
            count = (int)send(native, (const char *)data + done, chunk, MSG_NOSIGNAL);
#else
            count = (int)send(native, (const char *)data + done, chunk, 0);
#endif
        } else {
            count = (int)recv(native, (char *)data + done, chunk, 0);
        }
        if (count == @MACRO@_SOCKET_ERROR) {
            os_error = @MACRO@_LAST_ERROR();
            if (@NAME@_would_block(os_error) || @NAME@_interrupted(os_error)) {
                continue;
            }
            socket->last_transfer_count = done;
            return @NAME@_fail(socket, error, @MACRO@_PC_ERROR_SOCKET, os_error);
        }
        if (count == 0) {
            socket->last_transfer_count = done;
            return @NAME@_fail(socket, error, @MACRO@_PC_ERROR_DISCONNECT, 0);
        }
        done += (uint32_t)count;
        socket->last_transfer_count = done;
    }
    return 0;
}

