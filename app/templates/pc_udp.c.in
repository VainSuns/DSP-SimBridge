    socket->last_transfer_count = length;
    @NAME@_clear_staging(socket);
    return 0;
}

int @NAME@_pc_udp_recv_exact(@TYPED@PcUdpSocket *socket, uint8_t *data,
    uint32_t length, uint32_t timeout_ms, @TYPED@PcError *error)
{
    @TYPED@PcUdpDeadline deadline;
    @NAME@_pc_error_reset(error, "receive");
    if (length == 0u) {
        return @NAME@_pc_udp_recv_exact_until(socket, data, length,
            NULL, error);
    }
    if (@NAME@_pc_udp_deadline_start(socket, timeout_ms, &deadline,
            error) != 0) {
        @NAME@_pc_udp_close(socket);
        return -1;
    }
    return @NAME@_pc_udp_recv_exact_until(socket, data, length, &deadline,
        error);
}

int @NAME@_pc_udp_send_datagram_until(@TYPED@PcUdpSocket *socket,
    const uint8_t *data, uint32_t length,
    const @TYPED@PcUdpDeadline *deadline, @TYPED@PcError *error)
{
    @NAME@_native_socket native;
    int os_error = 0;
    int ready;
    int count;
    if (socket == NULL || !socket->valid ||
            (length != 0u && data == NULL) ||
            (length != 0u && deadline == NULL)) {
        if (error != NULL) {
            error->kind = @MACRO@_PC_ERROR_ARGUMENT;
            error->stage = "send";
        }
        return -1;
    }
    socket->last_transfer_count = 0u;
    if (length == 0u) return 0;
    if (length > (uint32_t)INT_MAX) {
        if (error != NULL) {
            error->kind = @MACRO@_PC_ERROR_ARGUMENT;
            error->stage = "send";
            c2837x_pc_error_set_lengths(error, length, 0u);
        }
        return -1;
    }
    ready = @NAME@_wait_writable(socket, deadline, error, &os_error);
    if (ready == 0) {
        return @NAME@_fail(socket, error, @MACRO@_PC_ERROR_TIMEOUT, 0);
    }
    if (ready < 0) {
        if (error != NULL && error->kind == @MACRO@_PC_ERROR_INTERNAL) {
            return -1;
        }
        return @NAME@_fail(socket, error, @MACRO@_PC_ERROR_SOCKET,
            os_error);
    }
    native = @NAME@_native(socket);
    count = (int)send(native, (const char *)data, (int)length,
        @MACRO@_SEND_FLAGS);
    if (count == @MACRO@_SOCKET_ERROR) {
        os_error = @MACRO@_LAST_ERROR();
        return @NAME@_fail(socket, error, @MACRO@_PC_ERROR_SOCKET,
            os_error);
    }
    if (count != (int)length) {
        socket->last_transfer_count = count > 0 ? (uint32_t)count : 0u;
        if (error != NULL) {
            c2837x_pc_error_set_lengths(error, length,
                count > 0 ? (uint32_t)count : 0u);
        }
        return @NAME@_fail(socket, error, @MACRO@_PC_ERROR_SOCKET, 0);
    }
    socket->last_transfer_count = (uint32_t)count;
    return 0;
}

int @NAME@_pc_udp_send_datagram(@TYPED@PcUdpSocket *socket,
    const uint8_t *data, uint32_t length, uint32_t timeout_ms,
    @TYPED@PcError *error)
{
    @TYPED@PcUdpDeadline deadline;
    @NAME@_pc_error_reset(error, "send");
    if (length == 0u) {
        return @NAME@_pc_udp_send_datagram_until(socket, data, length,
            NULL, error);
    }
    if (@NAME@_pc_udp_deadline_start(socket, timeout_ms, &deadline,
            error) != 0) {
        @NAME@_pc_udp_close(socket);
        return -1;
    }
    return @NAME@_pc_udp_send_datagram_until(socket, data, length, &deadline,
        error);
}

int @NAME@_pc_udp_send_all_until(@TYPED@PcUdpSocket *socket,
    const uint8_t *data, uint32_t length,
    const @TYPED@PcUdpDeadline *deadline, @TYPED@PcError *error)
{
    return @NAME@_pc_udp_send_datagram_until(socket, data, length, deadline,
        error);
}

int @NAME@_pc_udp_send_all(@TYPED@PcUdpSocket *socket,
    const uint8_t *data, uint32_t length, uint32_t timeout_ms,
    @TYPED@PcError *error)
{
    return @NAME@_pc_udp_send_datagram(socket, data, length, timeout_ms,
        error);
}
